{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "postbuild": "node -e \"const fs = require('node:fs'); if (fs.existsSync('dist/src/generated')) fs.rmSync('dist/src/generated', { recursive: true, force: true }); fs.cpSync('src/generated', 'dist/src/generated', { recursive: true });\"",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "test:contacts": "npm run build && node --test tests/contacts.integration.test.cjs",
    "test:applications": "npm run build && node --test tests/applications.integration.test.cjs",
    "test:tasks": "npm run build && node --test tests/tasks.integration.test.cjs",
    "test:projects": "npm run build && node --test tests/projects.integration.test.cjs",
    "test:notes": "npm run build && node --test tests/notes.integration.test.cjs",
    "test:calendar": "npm run build && node --test tests/calendar.integration.test.cjs",
    "test:documents": "npm run build && node --test tests/documents.integration.test.cjs",
    "prisma:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.0",
    "zod": "^4.4.3",
    "uploadthing": "^7.7.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.4"
  }
}
