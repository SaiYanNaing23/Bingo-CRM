// Learn more about Prisma schema here:
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum CompanyStatus {
  ACTIVE
  ARCHIVED
}

enum ApplicationStage {
  WISHLIST
  APPLIED
  HR
  TECHNICAL
  ASSIGNMENT
  FINAL
  OFFER
  REJECTED
  ARCHIVED
}

enum TaskType {
  JOB_APPLICATION
  FOLLOW_UP
  INTERVIEW
  LEARNING
  PROJECT
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskRepeatPattern {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectActivityType {
  CREATED
  PROGRESS_UPDATE
  COMMENT
}

enum CalendarEventType {
  INTERVIEW
  FOLLOW_UP
  DEADLINE
  OTHER
}

model User {
  id                String                    @id @default(uuid())
  fullName          String
  email             String                    @unique
  passwordHash      String
  role              UserRole                  @default(USER)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?
  companies         Company[]
  contacts          Contact[]
  applications      Application[]
  stageChanges      ApplicationStageHistory[]
  tasks             Task[]
  projects          Project[]
  projectActivities ProjectActivity[]
  notes             Note[]
  calendarEvents    CalendarEvent[]

  @@index([deletedAt])
  @@index([role])
}

model Company {
  id             String          @id @default(uuid())
  userId         String
  logo           String?
  name           String
  country        String?
  industry       String?
  website        String?
  linkedIn       String?
  careerPage     String?
  techStack      String[]
  size           Int?
  salaryRange    String?
  remote         Boolean         @default(false)
  notes          String?
  status         CompanyStatus   @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  contacts       Contact[]
  applications   Application[]
  linkedNotes    Note[]
  calendarEvents CalendarEvent[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([status])
  @@index([country])
}

model Contact {
  id             String    @id @default(uuid())
  userId         String
  companyId      String
  photo          String
  name           String
  email          String
  phone          String
  linkedIn       String
  role           String
  notes          String?
  lastContactAt  DateTime
  nextFollowUpAt DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications   Application[]
  linkedNotes    Note[]
  calendarEvents CalendarEvent[]

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([companyId])
}

model Application {
  id          String           @id @default(uuid())
  userId      String
  companyId   String
  position    String
  dateApplied DateTime?
  salary      String?
  timezone    String           @default("UTC")
  recruiter   String?
  stage       ApplicationStage @default(WISHLIST)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiterContact Contact?                  @relation(fields: [recruiter], references: [id], onDelete: SetNull)
  stageHistory     ApplicationStageHistory[]
  linkedNotes      Note[]
  calendarEvents   CalendarEvent[]

  @@index([userId, deletedAt])
  @@index([userId, companyId])
  @@index([userId, stage])
  @@index([userId, dateApplied])
  @@index([companyId])
  @@index([recruiter])
}

model ApplicationStageHistory {
  id            String            @id @default(uuid())
  applicationId String
  fromStage     ApplicationStage?
  toStage       ApplicationStage
  changedById   String
  createdAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User        @relation(fields: [changedById], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt, id])
  @@index([changedById])
}

model Task {
  id                 String            @id @default(uuid())
  userId             String
  title              String
  type               TaskType          @default(OTHER)
  priority           TaskPriority      @default(MEDIUM)
  dueDate            DateTime?
  timezone           String            @default("UTC")
  status             TaskStatus        @default(TODO)
  repeatPattern      TaskRepeatPattern @default(NONE)
  completedAt        DateTime?
  recurrenceSourceId String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurrenceSource Task?           @relation("TaskRecurrence", fields: [recurrenceSourceId], references: [id], onDelete: SetNull)
  nextOccurrence   Task?           @relation("TaskRecurrence")
  linkedNotes      Note[]
  calendarEvents   CalendarEvent[]

  @@index([userId, deletedAt])
  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([userId, type])
  @@index([userId, priority])
}

model Project {
  id             String        @id @default(uuid())
  userId         String
  name           String
  githubUrl      String?
  liveDemoUrl    String?
  status         ProjectStatus @default(PLANNED)
  progress       Int           @default(0)
  stack          String[]      @default([])
  screenshots    String[]      @default([])
  lessonsLearned String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities     ProjectActivity[]
  linkedNotes    Note[]
  calendarEvents CalendarEvent[]

  @@index([userId, deletedAt])
  @@index([userId, status])
  @@index([userId, updatedAt])
  @@index([stack], type: Gin)
}

model ProjectActivity {
  id           String              @id @default(uuid())
  projectId    String
  createdById  String
  type         ProjectActivityType
  fromStatus   ProjectStatus?
  toStatus     ProjectStatus?
  fromProgress Int?
  toProgress   Int?
  content      String?
  createdAt    DateTime            @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt, id])
  @@index([createdById])
}

model Note {
  id            String    @id @default(uuid())
  userId        String
  title         String
  content       String
  tags          String[]  @default([])
  companyId     String?
  contactId     String?
  applicationId String?
  taskId        String?
  projectId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, deletedAt])
  @@index([userId, updatedAt])
  @@index([companyId])
  @@index([contactId])
  @@index([applicationId])
  @@index([taskId])
  @@index([projectId])
  @@index([tags], type: Gin)
}

model CalendarEvent {
  id            String            @id @default(uuid())
  userId        String
  title         String
  type          CalendarEventType @default(OTHER)
  startAt       DateTime          @db.Timestamptz(3)
  endAt         DateTime?         @db.Timestamptz(3)
  timezone      String            @default("UTC")
  reminders     Int[]             @default([])
  companyId     String?
  contactId     String?
  applicationId String?
  taskId        String?
  projectId     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, deletedAt, startAt, id])
  @@index([userId, endAt])
  @@index([userId, type])
  @@index([companyId])
  @@index([contactId])
  @@index([applicationId])
  @@index([taskId])
  @@index([projectId])
}
