# Server Port & Environment
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
# For local PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/bingo_crm?schema=public"
# For Neon / Cloud PostgreSQL:
# DATABASE_URL="postgresql://user:password@ep-xyz.region.neon.tech/bingo_crm?sslmode=require"
# DIRECT_URL is optional, used for direct connection during migrations when using pooled Neon/Supabase connections:
# DIRECT_URL="postgresql://user:password@ep-xyz.region.neon.tech/bingo_crm?sslmode=require"
DATABASE_URL=

# Authentication (JWT)
JWT_SECRET=dev-jwt-secret
JWT_EXPIRES_IN=900

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging & Security
LOG_LEVEL=info
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Default Seed Admin Credentials
SEED_ADMIN_EMAIL=admin@devtrack.local
SEED_ADMIN_NAME="DevTrack Admin"
SEED_ADMIN_PASSWORD=DevTrackAdmin123!


# UploadThing Cloud Storage
UPLOADTHING_TOKEN=

# UploadThing Cloud Storage
UPLOADTHING_TOKEN=

